[{"type":"settings","style":"clean"},
{"type":"text","id":"t","x":160,"y":10,"text":"One KDA step: forget, erase, write","fontSize":25},
{"type":"text","id":"c","x":40,"y":50,"text":"standard attention appends to a cache that grows; KDA rewrites one fixed state","fontSize":16,"strokeColor":"#757575"},
{"type":"rectangle","id":"s0","x":40,"y":90,"width":300,"height":52,"roundness":{"type":3},"backgroundColor":"#a5d8ff","fillStyle":"solid","label":{"text":"state S from the last token","fontSize":17}},
{"type":"arrow","id":"a1","x":190,"y":142,"width":0,"height":0,"points":[[0,0],[0,40]],"endArrowhead":"arrow","label":{"text":"1. decay","fontSize":15}},
{"type":"rectangle","id":"s1","x":40,"y":182,"width":300,"height":52,"roundness":{"type":3},"backgroundColor":"#e9ecef","fillStyle":"solid","label":{"text":"S, shrunk a little\nin every channel","fontSize":17}},
{"type":"arrow","id":"a2","x":190,"y":234,"width":0,"height":0,"points":[[0,0],[0,40]],"endArrowhead":"arrow","label":{"text":"2. erase","fontSize":15}},
{"type":"rectangle","id":"s2","x":40,"y":274,"width":300,"height":52,"roundness":{"type":3},"backgroundColor":"#e9ecef","fillStyle":"solid","label":{"text":"S, minus what it held\nfor this key","fontSize":17}},
{"type":"arrow","id":"a3","x":190,"y":326,"width":0,"height":0,"points":[[0,0],[0,40]],"endArrowhead":"arrow","label":{"text":"3. write","fontSize":15}},
{"type":"rectangle","id":"s3","x":40,"y":366,"width":300,"height":52,"roundness":{"type":3},"backgroundColor":"#c3fae8","fillStyle":"solid","label":{"text":"new state S for this token","fontSize":17}},
{"type":"text","id":"n1","x":400,"y":128,"text":"multiply by a per-channel\ndecay; K3 bounds it, so\nlong spans stay stable","fontSize":16,"strokeColor":"#757575"},
{"type":"text","id":"n2","x":400,"y":220,"text":"remove a share of the old\nvalue stored under this key,\nbeta sets how much","fontSize":16,"strokeColor":"#757575"},
{"type":"text","id":"n3","x":400,"y":312,"text":"add the new key-value pair,\nscaled by a learned beta","fontSize":16,"strokeColor":"#757575"},
{"type":"text","id":"n4","x":400,"y":404,"text":"the state is the same size\nafter a million tokens as\nafter ten","fontSize":16,"strokeColor":"#757575"}]
